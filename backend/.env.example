# ===================================================================
# Backend (FastAPI) configuration
# ===================================================================
# Copy this file to backend/.env and fill in your real values.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — put secrets and your personal Tailscale
# IP there, NEVER in this example file (which IS committed to git).
# ===================================================================

# -------------------------------------------------------------------
# Local LLM (Ollama) endpoint
# -------------------------------------------------------------------
# The advisor talks to a local/self-hosted Ollama endpoint only. Choose one:
#
#   Same machine as the backend:
#     OLLAMA_BASE_URL=http://localhost:11434
#
#   Over Tailscale (Ollama on another tailnet node — put the REAL tailnet
#   IP in backend/.env, not here). Tailscale IPs are in the 100.64.0.0/10
#   range and are accepted by the local-only guard:
#     OLLAMA_BASE_URL=http://100.x.y.z:11434
#
# NOTE: for Ollama to answer on its Tailscale IP it must listen on that
# interface, i.e. start it with OLLAMA_HOST=0.0.0.0 (or the tailnet IP).
OLLAMA_BASE_URL=http://localhost:11434

# Model tag served by Ollama. This project targets Liquid LFM2 (~8B). The
# tag published on the target host is `lfm2.5:latest` (8.5B); `lfm2.5:8b`
# does not resolve on this host. Override if your host publishes a different tag.
OLLAMA_MODEL=lfm2.5:latest

# Reject non-local/public model endpoints so test calls can't spend cloud money.
# Keep this true; localhost, LAN/private IPs, and Tailscale IPs are allowed.
OLLAMA_LOCAL_ONLY=true

# -------------------------------------------------------------------
# Academic catalog database (catalog_ingestion Postgres)
# -------------------------------------------------------------------
# Rootless-podman Postgres publishes container 5432 -> host 5433.
ACADEMIC_DATABASE_URL=postgresql://catalog:catalog@localhost:5433/catalog_ingestion

# -------------------------------------------------------------------
# RAG / semantic retrieval (pgvector)
# -------------------------------------------------------------------
# The advisor answers by retrieving catalog chunks from the pgvector `academic_rules`
# table. The embedding model is SEPARATE from the chat model above and must be pulled:
#     ollama pull nomic-embed-text
# Then load the catalog into the vector store (one-off, re-run when the catalog changes):
#     python -m app.services.rag.ingest_catalog
# RAG_EMBED_DIMENSIONS must match the embedding model's output and the VECTOR(n) column.
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_DIMENSIONS=768
RAG_TOP_K=3
# Cosine-similarity floor (0..1); chunks below this are dropped. 0 disables the filter.
RAG_MIN_SIMILARITY=0.0
