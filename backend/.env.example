# ===================================================================
# Backend (FastAPI) configuration
# ===================================================================
# Copy this file to backend/.env and fill in your real values.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — put secrets there, NEVER in this example
# file (which IS committed to git).
# ===================================================================

# -------------------------------------------------------------------
# Ollama (local chat model)
# -------------------------------------------------------------------
# Production topology: this backend process and Ollama run on the SAME box (the RTX
# 2060 Super server, 24/7) — 127.0.0.1 is the real production value, not a dev-only
# shortcut. Use a literal IP, not "localhost": under uvicorn's uvloop, "localhost" can
# resolve to ::1 first and fail outright if Ollama is bound IPv4-only. Point at a
# different host only if you split the backend and Ollama onto separate machines.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# PLACEHOLDER pending model_eval/'s verdict (see repo root model_eval/README.md) on
# which 8GB-class model to standardize on for the 2060 Super. Must be `ollama pull`ed
# on the box this backend talks to.
OLLAMA_MODEL=llama3.1:8b

# Refuses to start if OLLAMA_BASE_URL isn't local/private (misconfiguration guard, not
# a security boundary). Set to false only if you deliberately point at a remote host.
OLLAMA_LOCAL_ONLY=true

# THE most important knob for output quality: Ollama silently defaults num_ctx to
# 2K-4K regardless of what the model supports. Set explicitly; match whatever
# model_eval/config.yaml measured the chosen model against.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.15
# Keeps the model resident in VRAM between requests on the same box.
OLLAMA_KEEP_ALIVE=15m

# -------------------------------------------------------------------
# Anthropic API — OPTIONAL swappable backend, not the active path
# -------------------------------------------------------------------
# services/anthropic_client.py is kept in case cloud inference is ever swapped back
# in; nothing in the app calls it while OllamaClient is wired into the routers. Unset
# unless you're deliberately testing that path.
# ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048

# -------------------------------------------------------------------
# Academic catalog database (catalog_ingestion Postgres)
# -------------------------------------------------------------------
# Docker Compose publishes container 5432 -> host 5433.
ACADEMIC_DATABASE_URL=postgresql://catalog:catalog@localhost:5433/catalog_ingestion

# -------------------------------------------------------------------
# RAG / semantic retrieval (pgvector)
# -------------------------------------------------------------------
# The advisor answers by retrieving catalog chunks from the pgvector `academic_rules`
# table. Embeddings are produced IN-PROCESS by fastembed/ONNX (BAAI/bge-small-en-v1.5,
# 384-d) — Ollama's embedding endpoint isn't used here, so retrieval works even if
# OLLAMA_MODEL changes or the chat model is temporarily down. First use downloads
# ~100MB of model weights to the local Hugging Face cache.
#
# Load (or reload) the catalog into the vector store — idempotent, safe to re-run:
#     python -m app.services.rag.ingest_catalog
#
# RAG_EMBED_DIMENSIONS must match the embedding model's output AND the VECTOR(n)
# column. Changing RAG_EMBED_MODEL means re-running ingest_catalog against a fresh
# table (stored vectors and query vectors must come from the same model).
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_DIMENSIONS=384
RAG_TOP_K=3
# Cosine-similarity floor (0..1); chunks below this are dropped so a weakly-related
# rule is never injected just to fill top_k. 0 disables the filter.
RAG_MIN_SIMILARITY=0.45

# Hard ceiling (approximate tokens, ~4 chars/token) on retrieved context packed into
# an advisor prompt. No per-token bill locally, but a bloated context still slows an
# 8GB card and can drown OLLAMA_NUM_CTX — this cap is enforced in code either way.
ADVISOR_CONTEXT_TOKEN_BUDGET=3000
