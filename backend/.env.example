# ===================================================================
# Backend (FastAPI) configuration
# ===================================================================
# Copy this file to backend/.env and fill in your real values.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored — put secrets there, NEVER in this example
# file (which IS committed to git).
# ===================================================================

# -------------------------------------------------------------------
# llama.cpp (local chat model, served by `llama-server`)
# -------------------------------------------------------------------
# Production topology: this backend process and llama-server run on the SAME box (the
# RTX 2060 Super server, 24/7) — 127.0.0.1 is the real production value, not a dev-only
# shortcut. Use a literal IP, not "localhost": under uvicorn's uvloop, "localhost" can
# resolve to ::1 first and fail outright if the server is bound IPv4-only. Point at a
# different host only if you split the backend and llama-server onto separate machines.
# Port 8080 is llama-server's default.
LLAMACPP_BASE_URL=http://127.0.0.1:8080

# THE BACKEND LAUNCHES LLAMA-SERVER ITSELF NOW (services/model_manager.py) — you do not need
# to hand-start it. On boot the app launches GEMMA 4 26B A4B by default and stops/relaunches it
# with a different gguf whenever a user picks a different model from the nav bar's model
# picker (GET/POST /v1/models*). LLAMACPP_MODEL below is therefore not something you set to
# choose a model — model_manager.py OVERWRITES it in memory on every switch, so every
# LlamaCppClient() (instantiated fresh per request, no args) and the health probe both always
# describe whatever is actually loaded. Its value here only matters before the very first
# launch completes.
#
# The three models available to the picker, and their launch flags (tensor-split, CPU-offloaded
# MoE layers), are defined in services/model_manager.py's AVAILABLE_MODELS — copied verbatim
# from model_eval/config.yaml's sweep so a model behaves in production exactly as it was
# measured. LLAMACPP_SERVER_EXE / LLAMACPP_MODELS_ROOT below say where the binary and the gguf
# files live; --ctx-size, cache types, --reasoning off etc. are the same fixed flags every
# model gets, same rationale as `model_eval/harness/server.py`'s "one launch command, every
# model identical" discipline.
LLAMACPP_MODEL=gemma-4-26B-A4B-it-UD-Q4_K_M.gguf
LLAMACPP_SERVER_EXE=/home/wylin/ai-academic-advisor/llama.cpp/build/bin/llama-server
LLAMACPP_MODELS_ROOT=/home/wylin/ai-academic-advisor/models
# How long a model switch waits for the new process to answer /health before giving up.
LLAMACPP_STARTUP_TIMEOUT_S=180

# Must equal the --ctx-size llama-server was launched with. Nothing can recover from
# getting this wrong: the two budgets below are sized against it, and an overflowing
# prompt is a failed request rather than a slow one.
LLAMACPP_CONTEXT_TOKENS=16384
# Mode B's own output ceiling (model_eval/config.yaml's run.max_plan_tokens). A plan of
# study is ~500 tokens of `semesters` at the median and never exceeded ~1200 in the whole
# eval corpus, so this is generous.
LLAMACPP_PLAN_MAX_TOKENS=2048
# Ceiling on the catalog export handed to Mode B. 16384 - 2048 (plan) - ~1900 (rules,
# student block, chat template) leaves ~12400; 11500 keeps slack for a long transcript.
PLAN_CONTEXT_TOKEN_BUDGET=11500
# A 26B MoE reading an 11k-token export spends most of a minute on the first request.
# The old hard-coded 120s was written for a 7B answering from three retrieved chunks.
LLAMACPP_TIMEOUT_S=600

# Refuses to start if LLAMACPP_BASE_URL isn't local/private (misconfiguration guard,
# not a security boundary). Set to false only if you deliberately point at a remote host.
LLAMACPP_LOCAL_ONLY=true

LLAMACPP_TEMPERATURE=0.15
# Generous ceiling so truncation is a model fault, not a config one. Unlike Ollama's
# num_ctx, llama-server's context size is fixed at process launch (--ctx-size above, not
# a backend env var) and can't be overridden per request — keep this comfortably under
# that so a long system+user prompt still leaves room to generate.
#
# RAISED FROM 1024, 2026-07-29. At 1024 the verbose models never finish a
# PlanEditProposal — model_eval measured rationales up to 10,659 characters (~2.7k
# tokens) — so revise-plan logged "unusable proposal" and silently degraded to a no-op.
# 4096 rather than more because PlanEditProposal.rationale is now capped at 400 chars by
# the schema/grammar, so the rambling that needed the room is no longer possible; the
# largest thing left to cover is explain_plan (free text, ~1400 tokens observed).
# Must match model_eval/config.yaml's run.max_output_tokens, or the eval is not measuring
# what ships.
LLAMACPP_MAX_TOKENS=4096

# -------------------------------------------------------------------
# Anthropic API — OPTIONAL swappable backend, not the active path
# -------------------------------------------------------------------
# services/anthropic_client.py is kept in case cloud inference is ever swapped back
# in; nothing in the app calls it while LlamaCppClient is wired into the routers. Unset
# unless you're deliberately testing that path.
# ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048

# -------------------------------------------------------------------
# Academic catalog database (catalog_ingestion Postgres)
# -------------------------------------------------------------------
# Docker Compose publishes container 5432 -> host 5433.
ACADEMIC_DATABASE_URL=postgresql://catalog:catalog@localhost:5433/catalog_ingestion

# -------------------------------------------------------------------
# RAG / semantic retrieval (pgvector)
# -------------------------------------------------------------------
# The advisor answers by retrieving catalog chunks from the pgvector `academic_rules`
# table. Embeddings are produced IN-PROCESS by fastembed/ONNX (BAAI/bge-small-en-v1.5,
# 384-d) — llama.cpp's embedding endpoint isn't used here, so retrieval works even if
# LLAMACPP_MODEL changes or the chat model is temporarily down. First use downloads
# ~100MB of model weights to the local Hugging Face cache.
#
# Load (or reload) the catalog into the vector store — idempotent, safe to re-run:
#     python -m app.services.rag.ingest_catalog
#
# RAG_EMBED_DIMENSIONS must match the embedding model's output AND the VECTOR(n)
# column. Changing RAG_EMBED_MODEL means re-running ingest_catalog against a fresh
# table (stored vectors and query vectors must come from the same model).
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBED_DIMENSIONS=384
RAG_TOP_K=3
# Cosine-similarity floor (0..1); chunks below this are dropped so a weakly-related
# rule is never injected just to fill top_k. 0 disables the filter.
RAG_MIN_SIMILARITY=0.45

# Hard ceiling (approximate tokens, ~4 chars/token) on retrieved context packed into
# an advisor prompt. No per-token bill locally, but a bloated context still slows an
# 8GB card and can overflow llama-server's fixed launch-time context window — this cap
# is enforced in code either way.
ADVISOR_CONTEXT_TOKEN_BUDGET=3000
