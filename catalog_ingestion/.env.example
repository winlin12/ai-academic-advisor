# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL connection string for the catalog ingestion database
DATABASE_URL=postgresql+psycopg://catalog:catalog@localhost:5432/catalog_ingestion

# User-agent sent with every catalog HTTP request
CATALOG_USER_AGENT=PurdueAcademicPlannerBot/1.0 (student hobby project; not affiliated with Purdue; contact: your@email.com)

# Base URL for the Purdue catalog
CATALOG_BASE_URL=https://catalog.purdue.edu

# Seconds to wait between catalog requests (robots.txt specifies 120s crawl-delay)
# Set lower only for development/testing against cached pages
CRAWL_DELAY_SECONDS=120

# Maximum pages to crawl during a single discover run (safety cap)
MAX_CRAWL_PAGES=500

# Local disk cache directory for raw HTML pages (prevents re-fetching)
PAGE_CACHE_DIR=.page_cache

# Set to "playwright" to use headless Chromium (needed for WAF-protected pages)
# Set to "httpx" for simple HTTP (only works for CDN-cached pages like index.php)
FETCHER_BACKEND=playwright

# Playwright browser executable (leave empty to use playwright's bundled Chromium)
PLAYWRIGHT_BROWSER=

# PurdueAPI OData base URL (optional — for course data import)
PURDUEAPI_ODATA_URL=https://api.purdue.io/odata

# Log level
LOG_LEVEL=INFO
